meta {
  name: Forgot password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "nobody-{{email}}"
  }
}

tests {
  test("answers 200 without revealing whether the email exists", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().message).to.be.a("string");
  });
}
