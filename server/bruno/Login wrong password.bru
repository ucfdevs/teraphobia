meta {
  name: Login wrong password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "not-the-right-password"
  }
}

tests {
  test("rejects the login", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.not.have.property("accessToken");
  });
}
