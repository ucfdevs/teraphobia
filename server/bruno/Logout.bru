meta {
  name: Logout
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/logout
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

tests {
  test("ends the session", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
