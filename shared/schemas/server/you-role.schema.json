{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YouRole",
  "description": "Server to one, event `you:role`. Sent privately at Start. Only the Monster's phone gets monsterType.",
  "type": "object",
  "properties": {
    "seatId": { "$ref": "../common.schema.json#/definitions/SeatId" },
    "role": { "$ref": "../common.schema.json#/definitions/Role" },
    "monsterType": {
      "description": "Monster only. Never sent to a Villager.",
      "$ref": "../common.schema.json#/definitions/MonsterType"
    },
    "costume": { "$ref": "../common.schema.json#/definitions/Costume" }
  },
  "required": ["seatId", "role", "costume"],
  "additionalProperties": false,
  "if": {
    "properties": { "role": { "const": "monster" } }
  },
  "then": {
    "required": ["monsterType"]
  },
  "else": {
    "not": { "required": ["monsterType"] }
  }
}
